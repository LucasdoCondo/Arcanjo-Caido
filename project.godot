[autoload]

GameState="*res://scripts/core/game_state.gd"
SceneTransition="*res://scripts/core/scene_transition.gd"
MapOverlay="*res://scripts/ui/map_overlay.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
CombatManager="*res://scripts/core/combat_manager.gd"
Achievements="*res://scripts/core/achievements.gd"
SaveManager="*res://scripts/core/save_manager.gd"
HUD="*res://scripts/ui/hud.gd"
PauseMenu="*res://scripts/ui/pause_menu.gd"
DisplayManager="*res://scripts/core/display_manager.gd"
InputRemap="*res://scripts/core/input_remap.gd"
Culling="*res://scripts/core/culling_manager.gd"
DialogueUI="*res://scripts/ui/dialogue_ui.gd"
;; Passo 23: DevMenu é ferramenta de QA — autodestrói-se fora de builds de
;; debug (OS.is_debug_build) e deve ser excluído do export via filtro
;; "scripts/debug/*" no export_presets.cfg.
DevMenu="*res://scripts/debug/dev_menu.gd"

[physics]

2d/default_gravity=980
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.07, 1)
viewport/hdr_2d=true
